{
	"name": "monorepo",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"dev": "concurrently --kill-others --raw \"npm run dev --prefix apps\"",
		"build": "concurrently --raw \"npm run build --prefix apps\"",
		"start": "concurrently --kill-others --raw",
		"lint": "concurrently --raw \"npm run lint --prefix apps\""
	},
	"devDependencies": {
		"@tailwindcss/typography": "^0.5.19",
		"concurrently": "^9.1.2"
	},
	"workspaces": [
		"apps"
	],
	"dependencies": {
		"framer-motion": "^12.38.0",
		"next-themes": "^0.4.6",
		"react-quill": "^2.0.0"
	}
}
